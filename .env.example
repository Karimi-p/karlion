# Copy to .env.local. NEVER commit real values.
# Only NEXT_PUBLIC_* values are visible to the browser. Everything else is server-only.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Bypasses RLS. Never expose, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n signed webhooks (shared secrets, min 32 chars: openssl rand -hex 32) ---
# App -> n8n: URL n8n exposes, and the secret the app signs with.
N8N_OUTBOUND_WEBHOOK_URL=
N8N_OUTBOUND_SIGNING_SECRET=
# n8n -> app: secret n8n signs with; the app verifies at /api/integrations/n8n
N8N_INBOUND_SIGNING_SECRET=

# --- Telegram (Phase 2) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Numeric Telegram user ID of the founder. All other senders are rejected.
TELEGRAM_FOUNDER_USER_ID=

# --- Slack (Phase 1 notifications go through n8n; app may hold the signing secret later) ---
SLACK_SIGNING_SECRET=

# --- App ---
APP_BASE_URL=http://localhost:3000
